{
    "name": "3omar-browser-tests",
    "version": "0.0.0",
    "private": true,
    "description": "Harness navigateur (Playwright + axe) pour les contrats de mise en page et d'accessibilite. Aucun asset applicatif n'est construit ici : Bootstrap, Bootstrap Icons et Chart.js restent charges par CDN.",
    "scripts": {
        "test:browser": "playwright test --config=tests/browser/playwright.config.js",
        "test:browser:update": "playwright test --config=tests/browser/playwright.config.js --update-snapshots",
        "test:browser:report": "playwright show-report tests/browser/.report"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.10.2",
        "@playwright/test": "1.61.1",
        "axe-core": "4.11.1"
    },
    "overrides": {
        "axe-core": "4.11.1",
        "playwright-core": "1.61.1"
    }
}
