APP_NAME="3omar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Pas de base de données — application 100% stateless
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local

# Google AdSense, chargé uniquement lorsque APP_ENV=production
ADSENSE_ENABLED=false
ADSENSE_CLIENT=
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_FOOTER=
