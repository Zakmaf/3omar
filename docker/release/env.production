APP_NAME="3omar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Proxies dont Laravel accepte les en-têtes X-Forwarded-* (CIDR séparés par des
# virgules). Laisser vide avec cette image : son Nginx résout déjà l'adresse réelle.
# Voir docs/DEPLOIEMENT.md, section « Adresse réelle et HTTPS ».
TRUSTED_PROXIES=

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Pas de base de données — application 100% stateless
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/database.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local

# Google AdSense, chargé uniquement lorsque APP_ENV=production
ADSENSE_ENABLED=false
ADSENSE_CLIENT=
ADSENSE_PUBLISHER_ID=
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_FOOTER=
